{
  "manifest_version": 3,
  "name": "Smart Download Manager Bridge",
  "version": "1.2.0",
  "description": "Bypasses Cloudflare by securely sharing cf_clearance cookies and download streams with Smart Download Manager.",
  "permissions": [
    "cookies",
    "downloads",
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8992/*",
    "http://localhost:8992/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-download-manager@benson.dev",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_title": "Smart Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
